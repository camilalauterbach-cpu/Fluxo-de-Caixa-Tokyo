# Optional Docker Compose / own-server configuration. Render asks for only
# TOKYO_ADMIN_EMAIL, TOKYO_ADMIN_PASSWORD and TOKYO_DATA_KEY in its private form.
TOKYO_PUBLIC_URL=https://tokyo.example.com
TOKYO_ADMIN_EMAIL=
# Initial administrator password: 10 to 200 characters.
TOKYO_ADMIN_PASSWORD=
TOKYO_DATA_KEY=
# Separate secret for encrypted database backups; Render generates this value.
TOKYO_BACKUP_KEY=
